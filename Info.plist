<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Reveal</string>
	<key>CFBundleIdentifier</key>
	<string>biz.panmachine.reveal</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Reveal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- No Dock icon or menu bar: the app runs unseen in the background. -->
	<key>LSUIElement</key>
	<true/>
	<!-- No App Nap: an app with no windows would otherwise be slowed while idle,
	     and a link must be handled before the user lets go of Shift. -->
	<key>NSAppSleepDisabled</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>biz.panmachine.reveal</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>reveal</string>
			</array>
		</dict>
	</array>
	<!-- Copy Reveal Link, offered for any file or folder. An NSRequiredContext,
	     even an empty one, lets the service be enabled without a trip to
	     System Settings. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Copy Reveal Link</string>
			</dict>
			<key>NSMessage</key>
			<string>copyRevealLink</string>
			<key>NSPortName</key>
			<string>Reveal</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
